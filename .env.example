# PostgreSQL local
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elshaday?schema=public"

# Supabase (copie em Project Settings → Database → Connection string)
# Transaction pooler (porta 6543) — uso do app (Prisma em runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) — migrate / db push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres"
# Se a senha tiver ! @ # etc., codifique na URL (! → %21, @ → %40)

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
AUTH_URL="http://localhost:3000"

# Site público: true = página "em desenvolvimento" na raiz; login e painel continuam ativos
SITE_UNDER_DEVELOPMENT=true
