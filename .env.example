# =============================================================================
# Desenvolvimento local
# =============================================================================

# PostgreSQL local (opcional)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elshaday?schema=public"

# Supabase — copie em Project Settings → Database → Connection string
# Transaction pooler (6543) — app em runtime (local e Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta (5432) — db push / migrate (só na sua máquina, não na Vercel)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres"
# Senha com ! @ # na URL: codifique (! → %21, @ → %40)

# NextAuth — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
AUTH_URL="http://localhost:3000"

# Site público fechado por padrão (página "em desenvolvimento" na raiz).
# Defina false só quando for abrir o site institucional completo:
# SITE_UNDER_DEVELOPMENT=false

# =============================================================================
# Vercel (Production) — adicione em Project → Settings → Environment Variables
# =============================================================================
#
# Nome                  | Valor
# ----------------------|------------------------------------------------------
# DATABASE_URL          | Pooler Supabase porta 6543 + ?pgbouncer=true&connection_limit=1
# DIRECT_URL            | Mesma string direta do Supabase (Prisma exige no schema)
# AUTH_SECRET           | Mesmo valor do .env local OU gere um novo para produção
# AUTH_URL              | https://SEU-DOMINIO.vercel.app (URL final, sem barra no final)
# SITE_UNDER_DEVELOPMENT| omita ou true (padrão: site fechado). Use false para abrir o site público
#
# Não é necessário definir NODE_ENV — a Vercel define automaticamente.
# Após o primeiro deploy, atualize AUTH_URL com o domínio real do projeto.
